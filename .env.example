# TuTop · overrides opcionales para desarrollo
# La beta Android ya incluye la configuración web pública del proyecto tutop-3a4f7.
# Nunca pongas aquí service-account JSON, claves privadas, contraseñas ni tokens.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Migración nacional 0.8.5.
# Mantener false hasta que firestore.v2.rules se haya validado/desplegado en el ambiente objetivo.
# Al activarlo, identidad universitaria, metadata nacional, ofertas, Busco... y búsquedas guardadas
# pueden persistirse mediante src/services/nationalBackend.ts.
VITE_TUTOP_SCHEMA_V2=false

# IA opcional: únicamente un endpoint/proxy público diseñado para TuTop.
# No incrustes claves privadas de Gemini/Groq/OpenRouter en la APK.
# Si queda vacío, Topi funciona con el asistente local híbrido sin costo.
VITE_TUTOP_AI_ENDPOINT=

# La beta estable usa Firebase REST + Firestore. No usa Storage, Functions, FCM ni Google Play.
