# TuTop · overrides opcionales para desarrollo
# La ruta V1 estable conserva temporalmente su configuración histórica.
# Nunca pongas aquí service-account JSON, claves privadas, contraseñas ni tokens.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Ambiente explícito para V2: development | staging | production.
# Una build V2 staging sólo acepta tutop-beta-vicmdlb-1356585881.
# V2 bloquea siempre el proyecto histórico tutop-3a4f7.
VITE_TUTOP_ENVIRONMENT=development
VITE_TUTOP_APP_VERSION=0.9.2-beta.0

# Migración nacional 0.9.2.
# Mantener false en la estable hasta que el ambiente objetivo tenga Rules/índices/catálogo validados.
VITE_TUTOP_SCHEMA_V2=false

# Cutovers de costo V2. Son fail-closed y sólo aceptan true en environment=staging.
# Mantener false hasta que npm check + typecheck + build + Firestore Emulator estén verdes.
# Reviews además requiere el índice evaluado_id + calificacion + fecha desplegado/validado.
# Favorites visible reemplaza la query ciega de hasta 200 IDs por membership exacta únicamente
# para los listings V2 actualmente hidratados; no se activa fuera de staging.
VITE_TUTOP_V2_REVIEWS_LAZY_CUTOVER=false
VITE_TUTOP_V2_WALLET_LAZY_CUTOVER=false
VITE_TUTOP_V2_FAVORITES_VISIBLE_CUTOVER=false

# Topi 0.9.2: Firebase AI Logic nativo -> endpoint privado opcional -> Topi local.
# Firebase AI se mantiene OFF por defecto fuera del staging controlado.
# No pongas una API key de Gemini/proveedor en variables Vite.
VITE_TUTOP_TOPI_FIREBASE_AI_ENABLED=false
VITE_TUTOP_TOPI_MODEL=gemini-3.8-flash

# Fallback remoto opcional. El endpoint DEBE ser un proxy HTTPS controlado por TuTop.
VITE_TUTOP_TOPI_REMOTE_ENABLED=false
VITE_TUTOP_TOPI_ENDPOINT=

# La ruta estable no activa por sí sola Storage, Functions, FCM, App Check enforcement ni Google Play.
# La beta V2 staging prepara FCM/App Check de forma aislada antes de cualquier release productivo.
