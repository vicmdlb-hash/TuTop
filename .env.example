# TuTop · configuración activa de la beta Spark / cero inversión
# Estos valores corresponden a la configuración WEB pública de Firebase.
# Nunca pegues aquí service-account JSON, claves privadas, contraseñas ni tokens.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# La beta activa usa Firebase REST + Firestore. No usa Storage, Functions, FCM ni Google Play.
# Si no defines estas variables, la app permite pegar firebaseConfig en runtime y lo guarda localmente.
