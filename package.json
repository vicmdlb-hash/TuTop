{
  "name": "tutop",
  "version": "0.7.0-beta.0",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "preflight": "node scripts/preflight.mjs",
    "upload:internal": "node scripts/upload-internal-sharing.mjs",
    "release:internal": "node scripts/release-internal.mjs",
    "check": "node scripts/check.mjs",
    "syntax:check": "node scripts/syntax-check.mjs",
    "logic:test": "node scripts/logic-tests.mjs",
    "policy:scan": "node scripts/policy-scan.mjs",
    "deps:mobile": "node scripts/install-mobile-deps.mjs",
    "android:bootstrap": "node scripts/android-bootstrap.mjs",
    "android:doctor": "node scripts/android-doctor.mjs",
    "functions:build": "npm --prefix functions run build",
    "security:test": "node scripts/security-tests.mjs",
    "firebase:doctor": "node scripts/firebase-doctor.mjs",
    "firebase:deploy:staging": "node scripts/deploy-firebase-staging.mjs",
    "functions:logic:test": "node scripts/functions-domain-tests.mjs",
    "test:rules": "node --test tests/firestore.rules.test.mjs",
    "test:storage-rules": "node --test tests/storage.rules.test.mjs",
    "test:firebase-rules": "npm run test:rules && npm run test:storage-rules",
    "android:assets": "node scripts/android-assets.mjs",
    "admin:doctor": "node scripts/admin-doctor.mjs",
    "external:doctor": "node scripts/external-readiness.mjs",
    "firebase:link": "node scripts/link-firebase-project.mjs",
    "firebase:deploy:spark": "firebase deploy --only firestore:rules,firestore:indexes,hosting",
    "firebase:emulators:spark": "firebase emulators:start --only auth,firestore,hosting",
    "v2:rules:prepare": "node scripts/prepare-firestore-v2-rules.mjs && node scripts/harden-canonical-v2-rules.mjs",
    "v2:catalog:plan": "node scripts/seed-v2-catalog.mjs",
    "v2:catalog:seed": "node scripts/seed-v2-catalog.mjs --apply",
    "v2:staging:readiness:test": "node scripts/staging-v2-readiness-tests.mjs",
    "v2:reservations:reconcile": "node scripts/reconcile-v2-reservations.mjs",
    "reservation-runner:safety:test": "node scripts/reservation-runner-safety-tests.mjs",
    "reputation:test": "node scripts/reputation-evidence-tests.mjs",
    "trusted-reputation:test": "node scripts/trusted-reputation-tests.mjs",
    "reservation-reconciliation:test": "node scripts/reservation-reconciliation-tests.mjs",
    "institutional-moderation:test": "node scripts/institutional-moderation-tests.mjs",
    "credential-retention:test": "node scripts/credential-retention-tests.mjs",
    "saved-search-notification:test": "node scripts/saved-search-notification-tests.mjs",
    "marketplace-observability:test": "node scripts/marketplace-observability-tests.mjs",
    "seller-profile:privacy:test": "node scripts/seller-profile-privacy-tests.mjs",
    "national-foundation:test": "node scripts/national-foundation-tests.mjs",
    "commerce-intelligence:test": "node scripts/commerce-intelligence-tests.mjs",
    "listing-schema-v2:test": "node scripts/listing-schema-v2-tests.mjs",
    "offline-performance:test": "node scripts/offline-performance-tests.mjs",
    "deps:mobile:blaze": "node scripts/install-mobile-deps-blaze.mjs",
    "ci:summary": "node scripts/ci-summary.mjs",
    "beta:ready": "node scripts/beta-ready.mjs",
    "github:ready": "node scripts/github-ready.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "TuTop — red universitaria y marketplace estudiantil de México",
  "dependencies": {
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.34.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "private": true
}
